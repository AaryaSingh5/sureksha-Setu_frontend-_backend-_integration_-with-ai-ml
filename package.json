{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "server": "tsx server/index.ts",
    "client": "vite --port=3000 --host=0.0.0.0",
    "risk-engine": "cd risk_engine && python -m uvicorn main:app --port 8001 --host 127.0.0.1",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT,RISK\" -c \"cyan,yellow,green\" \"npm run server\" \"npm run client\" \"npm run risk-engine\"",
    "build": "vite build",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "ble:gateway": "node ble_gateway_receiver.js",
    "test:mesh": "tsx tests/test_sos_mesh.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist suraksha_setu.db",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@vis.gl/react-google-maps": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sqlite3": "^6.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}